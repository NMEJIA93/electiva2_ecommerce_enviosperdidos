PORT=5000
JWT_SECRET=change_this_for_local_learning_min_32_chars
JWT_EXPIRES_IN=24h

# Local Mongo container in docker-compose
MONGODB_URI=mongodb://mongo:27017/ecommerce_enviosperdidos

# AWS SNS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:electiva2-ecommerce-notifications

# Optional background job settings
NOTIFICATION_CRON=*/2 * * * *
NOTIFICATION_MAX_RETRIES=3

NODE_ENV=development
